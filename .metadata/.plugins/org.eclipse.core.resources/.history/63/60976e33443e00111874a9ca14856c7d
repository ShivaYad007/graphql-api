spring.application.name=product-service

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/bss_billing_service
    username: root
    password: root
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: none   # VERY IMPORTANT (existing tables)
    show-sql: true
    properties:
      hibernate:
        format_sql: true